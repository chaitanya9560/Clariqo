# Server-only AI credentials. Never use NEXT_PUBLIC_ for Groq or a Supabase secret/service-role key.
GROQ_API_KEY=paste_your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Optional shared demo access code, entered by visitors before AI requests.
# DEMO_ACCESS_CODE=choose-a-private-demo-code

# Browser-safe Supabase project configuration (required for account access).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
